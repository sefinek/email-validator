{
  "name": "@sefinek/email-validator",
  "version": "3.0.0",
  "description": "Lightweight npm module for email address validation with optional MX record verification.",
  "keywords": [
    "dns",
    "email",
    "email-address-validator",
    "email-checker",
    "email-validator",
    "email-verifier",
    "email-verify",
    "emails",
    "mx",
    "mx-record",
    "mx-records",
    "syntax",
    "validation",
    "validator"
  ],
  "homepage": "https://sefinek.net/projects/email-validator",
  "bugs": {
    "url": "https://github.com/sefinek/email-validator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefinek/email-validator.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://sefinek.net/donate"
  },
  "license": "MIT",
  "author": "Sefinek <contact@sefinek.net> (https://sefinek.net)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./mx": {
      "types": "./src/mx.d.ts",
      "default": "./src/mx.js"
    }
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "src",
    "example.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "lint": "eslint .",
    "m": "ncu -u && npm install && npm update",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
